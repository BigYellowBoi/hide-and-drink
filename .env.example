# Copy to .env.local and fill in from Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Push alerts: the VAPID public key (base64url). Leave empty to hide the alerts toggle.
# Generate a key pair with `npx web-push generate-vapid-keys`; see docs/push.md.
VITE_VAPID_PUBLIC_KEY=
